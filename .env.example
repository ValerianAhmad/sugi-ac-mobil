# Environment Variables Template
# Copy file ini menjadi .env.local dan isi dengan data Anda

# Database (jika menggunakan database)
# DATABASE_URL="postgresql://user:password@localhost:5432/bengkel_db"

# Email Service (jika ingin kirim email otomatis dari form)
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT=587
# EMAIL_USER="your-email@gmail.com"
# EMAIL_PASSWORD="your-app-password"

# WhatsApp Business API (opsional)
# WA_API_KEY="your-whatsapp-api-key"
# WA_PHONE_NUMBER="6281234567890"

# Google Maps API (jika ingin fitur tambahan)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-api-key"

# Production URL
# NEXT_PUBLIC_SITE_URL="https://bengkelacsamsugi.com"
